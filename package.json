{
  "name": "dsh-flower-garden",
  "version": "2.18.0",
  "description": "A living flower garden with ten regions, 105 flowers, persistent discovery cards, special visitors and commissions, and a regional flower guide.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TThappy/dsh-flower-garden.git"
  },
  "homepage": "https://github.com/TThappy/dsh-flower-garden#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "runtime",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session-view",
    "game"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "desktop:setup": "install-electron",
    "build": "node tools/build.cjs",
    "test": "node tools/build.cjs --check && npm run test:game && npm run test:render && node --test test/desktop-broker.test.cjs test/desktop-package.test.cjs test/desktop-setup.test.cjs test/desktop-pin-store.test.cjs test/desktop-pet-size.test.cjs",
    "test:game": "node test/game.test.cjs",
    "test:render": "node test/render.test.cjs",
    "preview": "node tools/preview.cjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "electron": "44.11.4"
  }
}
