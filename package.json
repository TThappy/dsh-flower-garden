{
  "name": "dsh-flower-garden",
  "version": "2.6.0",
  "description": "A living flower garden: 45 flowers, 13 visitors, 12 curiosities, special commissions, resident plants and recurring ecological studies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TThappy/dsh-flower-garden.git"
  },
  "homepage": "https://github.com/TThappy/dsh-flower-garden#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session-view",
    "game"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "npm run test:game && npm run test:render",
    "test:game": "node test/game.test.cjs",
    "test:render": "node test/render.test.cjs",
    "preview": "node tools/preview.cjs"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
